#!/bin/sh
# ROADMAP.md -> Plane after any commit that touched ROADMAP.md (README.md).
# States, cycles and descriptions of keyed lines only; a new item is created by a deliberate
# `dart run tool/plane_sync.dart apply` on the default branch, which also writes the line's key.
# Never blocks a commit. Installed once per clone: `git config core.hooksPath tool/git-hooks`.
# It mirrors the committing checkout's own ROADMAP.md, a worktree's too; the token
# (`secrets/plane.env`), the cache and the log stay in the main clone, reached through the common
# git dir, and never move.
# `dart` comes from PATH, which may be older than the project's SDK: `dart run` would resolve the
# pubspec, and the package's language version is refused as too high. The tool needs nothing but
# dart:io and dart:convert, so it runs directly on an empty package config.
git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -qx ROADMAP.md || exit 0
main="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
main="${main%/.git}"
[ -f "$main/secrets/plane.env" ] || exit 0
# Git points these at the committing checkout's internals; the tool asks git for itself.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
echo "plane_sync: mirroring ROADMAP.md to Plane (keyed lines; log in $main/secrets/plane-sync.log)"
printf '{"configVersion":2,"packages":[]}' > "$main/secrets/plane-sync-packages.json"
dart --packages="$main/secrets/plane-sync-packages.json" tool/plane_sync.dart apply --no-create \
  >> "$main/secrets/plane-sync.log" 2>&1 \
  || echo "plane_sync: failed - see $main/secrets/plane-sync.log"
exit 0
